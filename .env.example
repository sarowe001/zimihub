# ==============================
# ডাটাবেস
# ==============================
# ডেভেলপমেন্টের জন্য SQLite (কোনো সেটআপ লাগে না)
DATABASE_URL="file:./dev.db"
# প্রোডাকশনে Postgres ব্যবহার করতে prisma/schema.prisma-তে provider = "postgresql" করুন এবং:
# DATABASE_URL="postgresql://user:password@host:5432/zimihub"

# ==============================
# অথেনটিকেশন (NextAuth)
# ==============================
# openssl rand -base64 32 দিয়ে একটি র‍্যান্ডম সিক্রেট বানান
AUTH_SECRET="change-this-to-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ==============================
# bKash পেমেন্ট গেটওয়ে (Tokenized Checkout API)
# sandbox creds: https://developer.bka.sh/ থেকে রেজিস্ট্রেশন করে নিন
# ==============================
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_CALLBACK_URL="http://localhost:3000/api/billing/bkash/callback"

# ==============================
# Nagad পেমেন্ট গেটওয়ে
# merchant onboarding: https://nagad.com.bd/ (Merchant Payment Gateway)
# ==============================
NAGAD_BASE_URL="http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0"
NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_PRIVATE_KEY=""
NAGAD_PG_PUBLIC_KEY=""
NAGAD_CALLBACK_URL="http://localhost:3000/api/billing/nagad/callback"

# ==============================
# AI Providers (আসল মডেল কল করার জন্য — নিজের key বসান)
# ==============================
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
GOOGLE_API_KEY=""

APP_URL="http://localhost:3000"
